{
  "name": "dsh-task-notice",
  "version": "0.2.0",
  "description": "Task completion notice for DeepSeek Harness: a global widget that tells you which project and session just finished, what was asked, and lets you jump straight back.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notice",
    "notification",
    "session",
    "completion"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsdown && npm run build:types",
    "build:types": "tsc -p tsconfig.host.build.json && tsc -p tsconfig.client.build.json",
    "link:host": "node scripts/link-host-packages.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.9.0",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webxiaobaiyu-droid/dsh-task-notice.git"
  },
  "homepage": "https://github.com/webxiaobaiyu-droid/dsh-task-notice#readme",
  "bugs": {
    "url": "https://github.com/webxiaobaiyu-droid/dsh-task-notice/issues"
  }
}
